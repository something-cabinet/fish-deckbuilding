[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
macos.debug = "res://../rust/target/debug/libgodot_battle_scaffold.dylib"
macos.release = "res://../rust/target/release/libgodot_battle_scaffold.dylib"
linux.debug.x86_64 = "res://../rust/target/debug/libgodot_battle_scaffold.so"
linux.release.x86_64 = "res://../rust/target/release/libgodot_battle_scaffold.so"
windows.debug.x86_64 = "res://../rust/target/debug/godot_battle_scaffold.dll"
windows.release.x86_64 = "res://../rust/target/release/godot_battle_scaffold.dll"
web.debug.threads.wasm32 = "res://../rust/target/wasm32-unknown-emscripten/debug/godot_battle_scaffold.threads.wasm"
web.release.threads.wasm32 = "res://../rust/target/wasm32-unknown-emscripten/release/godot_battle_scaffold.threads.wasm"
web.debug.wasm32 = "res://../rust/target/wasm32-unknown-emscripten/debug/godot_battle_scaffold.wasm"
web.release.wasm32 = "res://../rust/target/wasm32-unknown-emscripten/release/godot_battle_scaffold.wasm"
